# Cloudflare R2 (Painel R2 > Gerir tokens da API > token com "Object Read & Write" só para este bucket)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=amigos-arco-iris
# Opcional: endereço público do bucket (r2.dev ou domínio próprio). Sem ele, os ficheiros passam por /api/media.
R2_PUBLIC_URL=

# Segredo para assinar as sessões do backoffice (uma frase longa e aleatória)
AUTH_SECRET=
# Primeiro acesso ao backoffice: este email e password criam a primeira conta.
ADMIN_EMAIL=
ADMIN_PASSWORD=
